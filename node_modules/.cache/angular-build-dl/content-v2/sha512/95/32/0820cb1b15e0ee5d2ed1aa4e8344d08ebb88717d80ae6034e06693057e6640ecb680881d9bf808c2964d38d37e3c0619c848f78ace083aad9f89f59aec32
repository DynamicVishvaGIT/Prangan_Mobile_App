ound\\\"  (click)=\\\"goBack()\\\">\\n        <ion-icon name=\\\"arrow-back-sharp\\\" color=\\\"light\\\"></ion-icon>\\n      </ion-button>\\n    </ion-buttons>\\n  </ion-toolbar>\\n</ion-header>\\n\\n<ion-content>\\n  <ion-refresher slot=\\\"fixed\\\" (ionRefresh)=\\\"doRefresh($event)\\\">\\n    <ion-refresher-content></ion-refresher-content>\\n  </ion-refresher>\\n  <div class=\\\"padding-ionic\\\" *ngIf=\\\"images\\\">\\n    <ion-row >\\n      <ion-col size=\\\"6\\\" *ngFor=\\\"let image of images\\\">\\n        <ion-img *ngIf=\\\"image.image\\\" src=\\\"{{image.image}}\\\" (click)=\\\"viewImage(image.image)\\\"></ion-img>\\n        <div class=\\\"frame-div\\\" *ngIf=\\\"image.video\\\">\\n          <iframe class=\\\"responsive-iframe\\\" [src]=\\\"sanitizer.bypassSecurityTrustResourceUrl(image.video)\\\"  target=\\\"_parent\\\" allowfullscreen></iframe>\\n        </div>\\n        <br>\\n        <ion-item (click)=\\\"download(image.image)\\\" *ngIf=\\\"image.image\\\">\\n          <ion-icon name=\\\"download-outline\\\" ></ion-icon>\\n          <ion-label>Download</ion-label>\\n        </ion-item>\\n      </ion-col>\\n    </ion-row>\\n  </div>\\n</ion-content>\\n\";","import { HTTP } from '@ionic-native/http/ngx';\nimport { ApiService } from './../api.service';\nimport { Component, OnInit } from '@angular/core';\nimport { ActivatedRoute } from '@angular/router';\nimport { Location } from '@angular/common';\n// import { FileTransfer, FileTransferObject } from '@ionic-native/file-transfer/ngx';\nimport { PhotoViewer } from '@ionic-native/photo-viewer/ngx';\nimport { File } from '@ionic-native/file/ngx';\nimport { DomSanitizer } from \"@angular/platform-browser\";\nimport { AndroidPermissions } from '@ionic-native/android-permissions/ngx';\nimport { AlertController } from '@ionic/angular';\n\ndeclare var Math;\n@Component({\n  selector: 'app-gallerytwo',\n  templateUrl: './gallerytwo.page.html',\n  styleUrls: ['./gallerytwo.page.scss'],\n})\nexport class GallerytwoPage implements OnInit {\n  event;\n  id;\n  images: any;\n  name: string;\n  // fileTransfer: FileTransferObject\n\n  constructor(\n    public route: ActivatedRoute,\n    public apiService: ApiService,\n    public location:Location,\n    public photoViewer: PhotoViewer,\n    private file: File,\n    public sanitizer: DomSanitizer,\n    public http:HTTP,\n    private androidPermissions: AndroidPermissions,\n    public alertController: AlertController,\n\n\n  ) { \n    \n  }\n\n  ngOnInit() {\n  }\n  ionViewDidEnter(){\n    this.route.paramMap.subscribe(params=>{\n      this.id = params.get('id');\n      this.name = params.get('name');\n      this.apiService.fetchAlbumDetails(this.id).then(data=>{\n        console.log('data',data);\n        this.images=JSON.parse(data.data)\n      })\n    });\n  }\n  goBack(){\n    this.location.back()\n  }\n  async presentAlert(message) {\n    const alert = await this.alertController.create({\n      header: 'Successful',\n      message: message,\n      mode: 'ios',\n      backdropDismiss: false,\n      buttons: [\n        {\n          text: 'OK',\n          handler: () => {\n           console.log('ok');\n          },\n        },\n      ],\n    });\n    await alert.present();\n  }\n  download(url){\n    if(url){\n      this.androidPermissions.checkPermission(this.androidPermissions.PERMISSION.READ_EXTERNAL_STORAGE).then(data=>{\n        console.log(data);\n        if(!data.hasPermission){\n          console.log('1');\n          this.apiService.presentToast('Storage permission is not turned on',2000)\n          this.androidPermissions.requestPermissions([this.androidPermissions.PERMISSION.READ_EXTERNAL_STORAGE])\n        }\n        else{\n          console.log('2');\n          var filename=this.parseUrlFilename(url)\n          console.log('filename',filename);\n          const filePath = this.file.externalRootDirectory+'/Download/' + filename;\n            this.http.downloadFile(url, {}, {}, filePath).then(response => {\n              this.presentAlert('Image saved to Downloads folder');\n            }).catch(err => {\n              this.apiService.presentToast(err.error,2000)\n                // prints 403\n                console.log('error block ... ', err.status);\n                // prints Permission denied\n                console.log('error block ... ', err.error);\n            })\n        }\n      }).catch(err=>{\n      \n        this.androidPermissions.requestPermissions([this.androidPermissions.PERMISSION.READ_EXTERNAL_STORAGE])\n      })\n      \n    }\n   \n  }\n  parseUrlFilename(url, defaultFilename = null) {\n    let filename = new URL(url, \"https://example.com\").href.split(\"#\").shift().split(\"?\").shift().split(\"/\").pop(); //No need to change \"https://example.com\"; it's only present to allow for processing relative URLs.\n    if(!filename) {\n        if(defaultFilename) {\n            filename = defaultFilename;\n        //No default filename provided; use a pseudorandom string.\n        } else {\n            filename = Math.random().toString(36).substr(2, 10);\n            // filename='abc.png'\n        }\n    }\n    \n    return filename;\n}\n  viewImage(url){\n    if(url){\n      this.photoViewer.show(url, '', {share: true});\n\n    }\n\n  }\n  doRefresh(event){\n    this.route.paramMap.subscribe(params=>{\n      this.id = params.get('id');\n      this.name = params.get('name');\n      this.apiService.fetchAlbumDetails(this.id).then(data=>{\n        console.log('data',data);\n        this.images=JSON.parse(data.data)\n      event.target.complete()\n\n      }).catch(err=>{\n      event.target.complete()\n\n      })\n    });\n  }\n}\n","import { NgModule } from '@angular/core';\nimport { Routes, RouterModule } from '@angular/router';\n\nimport { GallerytwoPage } from './gallerytwo.page';\n\nconst routes: Routes = [\n  {\n    path: '',\n    component: GallerytwoPage\n  }\n];\n\n@NgModule({\n  imports: [RouterModule.forChild(routes)],\n  exports: [RouterModule],\n})\nexport class GallerytwoPageRoutingModule {}\n"],"sourceRoot":"webpack:///"}