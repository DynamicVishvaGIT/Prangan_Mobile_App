ycare(this.user_id).then(data=>{\n          this.orders=JSON.parse(data.data)\n          console.log('fess',this.orders)\n          this.isOrdersAvailable=true;\n        }).catch(err=>{\n          this.orders=''\n          this.isOrdersAvailable=false;\n          console.log(err);\n        })\n       \n      }\n      })\n    })\n\n\n  }\n  ConvertTimeStamp(time) {\n      return this.formatDate(new Date(time * 1000));\n  }\n  formatDate(date) {\n      \n      var d = new Date(date), month = '' + (d.getMonth() + 1), day = '' + d.getDate(), year = d.getFullYear();\n      if (month.length < 2)\n          month = '0' + month;\n      if (day.length < 2)\n          day = '0' + day;\n      return [day, month, year].join('/') +\" \"+ d.getHours()+\":\"+d.getMinutes();\n  }\n  doRefresh(event){\n    this.storage.get('user').then(data=>{\n      this.branch_id = JSON.parse(data).branch_id;\n      this.user_id = JSON.parse(data).id;\n      this.storage.get('userType').then(userType=>{\n        this.userType=userType\n        this.apiService.paymentHistory(this.userType,this.user_id).then(data=>{\n          console.log(data);\n          this.orders=JSON.parse(data.data)\n          this.isOrdersAvailable=true;\n          event.target.complete()\n\n        }).catch(err=>{\n          console.log(err);\n          this.isOrdersAvailable=false;\n          this.orders=''\n          event.target.complete()\n        })\n      })\n    })\n  }\n}\n","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { FormsModule } from '@angular/forms';\n\nimport { IonicModule } from '@ionic/angular';\n\nimport { PaymenthistoryPageRoutingModule } from './paymenthistory-routing.module';\n\nimport { PaymenthistoryPage } from './paymenthistory.page';\n\n@NgModule({\n  imports: [\n    CommonModule,\n    FormsModule,\n    IonicModule,\n    PaymenthistoryPageRoutingModule\n  ],\n  declarations: [PaymenthistoryPage]\n})\nexport class PaymenthistoryPageModule {}\n",